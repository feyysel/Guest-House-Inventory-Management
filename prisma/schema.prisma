
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  MANAGER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  DELUXE
  SUITE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TELEBIRR
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  id           String     @id @default(cuid())
  roomNumber   String     @unique
  name         String?
  type         RoomType   @default(SINGLE)
  status       RoomStatus @default(AVAILABLE)
  capacity     Int        @default(2)
  pricePerNight Decimal   @db.Decimal(12, 2)
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations Reservation[]
}

model Guest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String
  address     String?
  nationality String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id           String            @id @default(cuid())
  bookingCode  String            @unique @default(cuid())
  guestId      String
  roomId       String
  checkIn      DateTime
  checkOut     DateTime
  adults       Int               @default(1)
  children     Int               @default(0)
  status       ReservationStatus @default(PENDING)
  totalAmount  Decimal           @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  guest        Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room         Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([guestId])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  reservationId   String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  transactionRef  String?       @unique
  notes           String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  reservation     Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([status])
}


model GuestHouseSettings {
  id             String   @id @default(cuid())
  guesthouseName String   @default("HavenStay Guest House")
  email          String?
  phone          String?
  address        String?
  checkInTime    String   @default("12:00")
  checkOutTime   String   @default("11:00")
  currency       String   @default("ETB")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
