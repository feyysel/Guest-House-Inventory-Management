# Required: PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/guesthouse?schema=public"

# Required in production: random string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: Redis cache. If unset or unreachable, data is read directly from PostgreSQL.
REDIS_URL="redis://127.0.0.1:6379"

# Optional: seed account overrides. Default values are for local demo use only.
SEED_ADMIN_NAME="Alice Admin"
SEED_ADMIN_EMAIL="admin@havenstay.test"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_MANAGER_NAME="Marta Manager"
SEED_MANAGER_EMAIL="manager@havenstay.test"
SEED_MANAGER_PASSWORD="change-this-password"
SEED_RECEPTIONIST_NAME="Sam Receptionist"
SEED_RECEPTIONIST_EMAIL="receptionist@havenstay.test"
SEED_RECEPTIONIST_PASSWORD="change-this-password"
